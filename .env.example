# Copy to .env and fill in the values.

# MySQL/MariaDB connection string.
DATABASE_URL="mysql://user:password@localhost:3306/lms"

# Random secret, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# Address the site is served from.
BETTER_AUTH_URL=http://localhost:3000

# First admin account, created by `pnpm db:seed`.
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Optional: password for the sample instructor and learners created by the dev seed.
SEED_SAMPLE_PASSWORD=

# Cloudflare R2 (media uploads). Leave empty to keep uploads disabled.
# Account ID: Cloudflare dashboard > R2 > Overview (right side).
R2_ACCOUNT_ID=
# R2 > Manage API Tokens > Create API token (Object Read & Write, both buckets).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Public bucket name, e.g. lms-media
R2_BUCKET=
# Public base URL of that bucket, no trailing slash:
# a custom domain (https://media.example.com) or the bucket's https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
# Private bucket for lesson videos and files (public access off), e.g. lms-lessons.
# Leave empty to keep lesson uploads disabled.
R2_PRIVATE_BUCKET=

# Stripe (paid checkout). Leave empty to keep paid checkout disabled.
# Secret API key: Stripe dashboard > Developers > API keys (sk_test_... while testing).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_...). Locally, `stripe listen --forward-to localhost:3000/api/stripe/webhook` prints it.
STRIPE_WEBHOOK_SECRET=

# Email (SMTP). Leave SMTP_HOST empty to print emails to the server console instead.
SMTP_HOST=
# 587 (STARTTLS) or 465 (TLS).
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to recipients, e.g. "EdX Learning <no-reply@example.com>".
EMAIL_FROM=

# Docker Compose only (docker-compose.yml, see deploy.md). Not used by `pnpm dev`.
# The database container needs no settings: it runs as root with no password (dev and beta only).
# Port on the server (127.0.0.1 only) where the app listens for the server's Nginx. Default 3000.
# APP_PORT=3000
# Only for a server with no web server of its own: start the Caddy container, which takes ports 80 and 443
# and gets the HTTPS certificate for DOMAIN (leave DOMAIN empty for plain HTTP on the server's IP).
# COMPOSE_PROFILES=caddy
DOMAIN=
# true = also create the sample courses, learners and blog posts (for a demo or beta site).
SEED_SAMPLES=false
# Optional, with Caddy: other host ports than 80 and 443.
# HTTP_PORT=8080
# HTTPS_PORT=8443
