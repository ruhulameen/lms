// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String             @unique
  emailVerified       Boolean            @default(false)
  name                String
  image               String?            @db.Text
  status              UserStatus         @default(ACTIVE)
  twoFactorEnabled    Boolean            @default(false)
  // Public author bio shown on blog posts.
  bio                 String?            @db.Text
  // Where the person came from when they signed up (campaign, referrer).
  attribution         Json?
  role                Role?              @relation(fields: [roleId], references: [id])
  roleId              Int?
  sessions            Session[]
  accounts            Account[]
  twoFactors          TwoFactor[]
  activityLogs        ActivityLog[]
  uploadedMedia       Media[]
  blogPosts           BlogPost[]
  blogPostRevisions   BlogPostRevision[]
  instructedCourses   Course[]           @relation("CourseInstructor")
  createdCourses      Course[]           @relation("CourseCreator")
  enrolments          Enrolment[]        @relation("EnrolmentLearner")
  assignedEnrolments  Enrolment[]        @relation("EnrolmentAssigner")
  courseReviews       CourseReview[]     @relation("ReviewAuthor")
  moderatedReviews    CourseReview[]     @relation("ReviewModerator")
  quizAttempts        QuizAttempt[]
  certificates        Certificate[]      @relation("CertificateOwner")
  revokedCertificates Certificate[]      @relation("CertificateRevoker")
  orders              Order[]
  orderEvents         OrderEvent[]
  createdRefunds      Refund[]
  createdCoupons      Coupon[]
  couponRedemptions   CouponRedemption[]
  personalCoupons     CouponUser[]
  notifications       Notification[]
  updatedSettings     Setting[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([roleId])
  @@map("user")
}

// Roles are rows (student, instructor, admin, moderator, ...) so new ones need no migration.
model Role {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  description String?
  users       User[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("role")
}

model Permission {
  id          Int              @id @default(autoincrement())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permission")
}

model RolePermission {
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  roleId       Int
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  permissionId Int

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permission")
}

// Messages shown in a person's panel: written by notify in src/services/notification.ts.
model Notification {
  id        Int       @id @default(autoincrement())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  // One of notificationTypes in src/lib/notification.ts, e.g. order.paid.
  type      String    @db.VarChar(40)
  title     String
  body      String?   @db.Text
  // Where clicking it leads, a path on this site.
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@map("notification")
}

// Who did what: written by logActivity in src/services/activity.ts.
model ActivityLog {
  id        Int      @id @default(autoincrement())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId    Int?
  action    String // e.g. user.suspend
  entity    String // e.g. user
  entityId  String?
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([entity, entityId])
  @@map("activity_log")
}

// The models below are managed by Better Auth (see src/lib/auth.ts).
model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?  @db.Text
  userAgent String?  @db.Text
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String    @db.Text
  providerId            String    @db.Text
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                Int
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String   @db.Text
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier(length: 191)])
  @@map("verification")
}

model TwoFactor {
  id                      Int       @id @default(autoincrement())
  secret                  String    @db.Text
  backupCodes             String    @db.Text
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                  Int
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret(length: 191)])
  @@index([userId])
  @@map("two_factor")
}

// Fixed-window limiter for server actions: see src/lib/rate-limit.ts.
model RateLimit {
  id          Int      @id @default(autoincrement())
  key         String   @unique @db.VarChar(255)
  count       Int      @default(0)
  windowStart DateTime

  @@index([windowStart])
  @@map("rate_limit")
}

enum EmailStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

// Outgoing email queue: see src/lib/email.ts. A row is written when something
// asks for an email, and delivered after the response has gone out.
model EmailOutbox {
  id        Int         @id @default(autoincrement())
  to        String
  subject   String
  // Emptied once sent, since it can hold sign-in and reset links.
  text      String      @db.Text
  status    EmailStatus @default(PENDING)
  attempts  Int         @default(0)
  lastError String?     @db.Text
  // Not tried again before this time (set after a failed attempt).
  nextTryAt DateTime    @default(now())
  sentAt    DateTime?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status, nextTryAt])
  @@index([createdAt])
  @@map("email_outbox")
}

// Site settings edited at /admin/settings: one row per group ("site",
// "certificate", "payment", "email", "storage", "tracking"), the fields as JSON. Secret
// fields are stored encrypted (src/lib/secret-box.ts). A missing row or field
// means the default, see src/lib/settings-schema.ts.
model Setting {
  key         String   @id @db.VarChar(40)
  value       Json
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedById Int?
  updatedAt   DateTime @updatedAt

  @@map("setting")
}

// ---------------------------------------------------------------------------
// Phase 2: CMS
// ---------------------------------------------------------------------------

enum MediaKind {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
}

// PENDING rows are uploads in flight; stale ones are removed by cleanupStaleUploads.
enum MediaUploadStatus {
  PENDING
  READY
}

enum ContentStatus {
  DRAFT
  PENDING_REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum SeoEntityType {
  POST
  COURSE
}

// Root folders (parentId null) are unique by name in code: MySQL allows
// duplicate NULLs in a unique index.
model MediaFolder {
  id        Int           @id @default(autoincrement())
  name      String
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Restrict)
  parentId  Int?
  children  MediaFolder[] @relation("FolderTree")
  media     Media[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([parentId, name])
  @@map("media_folder")
}

model Media {
  id                Int               @id @default(autoincrement())
  // Object key in the R2 bucket, generated on the server.
  key               String            @unique @db.VarChar(255)
  originalFilename  String
  title             String?
  altText           String?
  caption           String?           @db.Text
  description       String?           @db.Text
  mimeType          String            @db.VarChar(100)
  kind              MediaKind
  // BigInt: videos go up to 2 GB, past the 32-bit Int range.
  size              BigInt
  width             Int?
  height            Int?
  folder            MediaFolder?      @relation(fields: [folderId], references: [id], onDelete: Restrict)
  folderId          Int?
  uploadedBy        User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  uploadedById      Int?
  uploadStatus      MediaUploadStatus @default(PENDING)
  // Only set while a multipart upload is in progress.
  multipartUploadId String?           @db.VarChar(512)
  posts             BlogPost[]
  courseThumbnails  Course[]
  seoImages         SeoData[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([folderId])
  @@index([uploadedById])
  @@index([kind])
  @@index([uploadStatus, createdAt])
  @@index([createdAt])
  @@index([originalFilename])
  @@map("media")
}

model BlogCategory {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?    @db.Text
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("blog_category")
}

model BlogTag {
  id        Int           @id @default(autoincrement())
  name      String
  slug      String        @unique
  posts     BlogPostTag[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("blog_tag")
}

model BlogPostTag {
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId  Int

  @@id([postId, tagId])
  @@index([tagId])
  @@map("blog_post_tag")
}

model BlogPost {
  id              Int                @id @default(autoincrement())
  title           String
  slug            String             @unique
  body            Json
  excerpt         String?            @db.Text
  featuredImage   Media?             @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  featuredImageId Int?
  author          User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId        Int?
  category        BlogCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId      Int?
  tags            BlogPostTag[]
  featured        Boolean            @default(false)
  status          ContentStatus      @default(DRAFT)
  publishAt       DateTime?
  publishedAt     DateTime?
  revisions       BlogPostRevision[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([featuredImageId])
  @@index([authorId])
  @@index([categoryId])
  @@index([status, publishAt])
  @@index([publishedAt])
  @@index([featured])
  @@map("blog_post")
}

model BlogPostRevision {
  id          Int      @id @default(autoincrement())
  post        BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int
  number      Int
  title       String
  slug        String
  body        Json
  excerpt     String?  @db.Text
  seo         Json?
  categoryId  Int?
  // Array of tag ids.
  tagIds      Json?
  note        String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById Int?
  createdAt   DateTime @default(now())

  @@unique([postId, number])
  @@index([createdById])
  @@map("blog_post_revision")
}

// Polymorphic on purpose (no foreign key): posts and courses use it, categories may later.
// Delete the row when its entity is deleted.
model SeoData {
  id              Int           @id @default(autoincrement())
  entityType      SeoEntityType
  entityId        Int
  title           String?
  metaDescription String?       @db.Text
  canonicalUrl    String?       @db.Text
  noindex         Boolean       @default(false)
  socialImage     Media?        @relation(fields: [socialImageId], references: [id], onDelete: SetNull)
  socialImageId   Int?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([entityType, entityId])
  @@index([socialImageId])
  @@map("seo_data")
}

// ---------------------------------------------------------------------------
// Phase 4: LMS
// ---------------------------------------------------------------------------

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum LessonType {
  VIDEO
  TEXT
  DOCUMENT
  QUIZ
  // A SCORM 1.2 package, played in a frame: see src/services/scorm.ts.
  SCORM
}

enum EnrolmentSource {
  FREE
  ADMIN
  ORDER
}

enum EnrolmentStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
}

model CourseCategory {
  id          Int              @id @default(autoincrement())
  name        String
  slug        String           @unique
  description String?          @db.Text
  sortOrder   Int              @default(0)
  courses     Course[]
  coupons     CouponCategory[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([sortOrder])
  @@map("course_category")
}

model CourseTag {
  id        Int             @id @default(autoincrement())
  name      String
  slug      String          @unique
  courses   CourseTagLink[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@map("course_tag")
}

model CourseTagLink {
  course   Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId Int
  tag      CourseTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  tagId    Int

  @@id([courseId, tagId])
  @@index([tagId])
  @@map("course_tag_link")
}

// Prices are in pounds; 0 is a free course. Lesson files (the intro video and
// the files on lessons) live in the private bucket: only the key is stored,
// never a URL (see src/services/lesson-access.ts).
model Course {
  id               Int             @id @default(autoincrement())
  title            String
  slug             String          @unique
  subtitle         String?         @db.VarChar(255)
  shortDescription String?         @db.Text
  // Rich text document, same format as post bodies.
  description      Json?
  thumbnail        Media?          @relation(fields: [thumbnailId], references: [id], onDelete: SetNull)
  thumbnailId      Int?
  // Unsplash photo id shown until a thumbnail is chosen (sample data).
  externalImageId  String?         @db.VarChar(100)
  introVideoKey    String?         @db.VarChar(255)
  introVideoName   String?
  introVideoMime   String?         @db.VarChar(100)
  introVideoSize   BigInt?
  price            Decimal         @default(0) @db.Decimal(10, 2)
  // The "was" price shown struck through; must be above price to count as a discount.
  compareAtPrice   Decimal?        @db.Decimal(10, 2)
  level            CourseLevel     @default(ALL_LEVELS)
  language         String          @default("English") @db.VarChar(50)
  // Shown on the course; when null the lesson durations are summed.
  durationMinutes  Int?
  badge            String?         @db.VarChar(60)
  featured         Boolean         @default(false)
  instructor       User?           @relation("CourseInstructor", fields: [instructorId], references: [id], onDelete: SetNull)
  instructorId     Int?
  category         CourseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  categoryId       Int?
  tags             CourseTagLink[]
  status           ContentStatus   @default(DRAFT)
  publishAt        DateTime?
  publishedAt      DateTime?
  createdBy        User?           @relation("CourseCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdById      Int?
  modules          CourseModule[]
  lessons          Lesson[]
  enrolments       Enrolment[]
  reviews          CourseReview[]
  certificates     Certificate[]
  orderItems       OrderItem[]
  coupons          CouponCourse[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([thumbnailId])
  @@index([instructorId])
  @@index([createdById])
  @@index([categoryId])
  @@index([status, publishAt])
  @@index([publishedAt])
  @@index([featured])
  @@map("course")
}

model CourseModule {
  id          Int      @id @default(autoincrement())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    Int
  title       String
  description String?  @db.Text
  position    Int
  lessons     Lesson[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([courseId, position])
  @@map("course_module")
}

model Lesson {
  id              Int              @id @default(autoincrement())
  module          CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId        Int
  // Kept next to moduleId so progress and access checks need no join.
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        Int
  title           String
  slug            String           @db.VarChar(120)
  type            LessonType
  // Rich text document, for text lessons (and notes on the others).
  content         Json?
  // Private-bucket file of a video or document lesson.
  fileKey         String?          @db.VarChar(255)
  fileName        String?
  fileMimeType    String?          @db.VarChar(100)
  fileSize        BigInt?
  durationSeconds Int?
  // SCORM lessons: the folder in the private bucket the package was unpacked
  // into, the page inside it that starts the course, and two values from its
  // manifest that the package may ask for (fileKey still holds the zip itself).
  scormPrefix     String?          @db.VarChar(255)
  scormEntry      String?          @db.VarChar(500)
  scormMastery    Int?
  scormLaunchData String?          @db.Text
  scormStates     ScormState[]
  position        Int
  isFreePreview   Boolean          @default(false)
  // Unpublished lessons are hidden from learners and the public page.
  published       Boolean          @default(true)
  resources       LessonResource[]
  progress        LessonProgress[]
  quiz            Quiz?
  lastEnrolments  Enrolment[]      @relation("EnrolmentLastLesson")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([courseId, slug])
  @@index([moduleId, position])
  @@map("lesson")
}

model LessonResource {
  id           Int      @id @default(autoincrement())
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     Int
  title        String
  fileKey      String   @db.VarChar(255)
  fileName     String
  fileMimeType String   @db.VarChar(100)
  fileSize     BigInt
  position     Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([lessonId, position])
  @@map("lesson_resource")
}

// Learner records are never deleted along with a user or course: the foreign
// keys restrict. Cancel an enrolment (status) instead of removing it.
model Enrolment {
  id              Int              @id @default(autoincrement())
  user            User             @relation("EnrolmentLearner", fields: [userId], references: [id], onDelete: Restrict)
  userId          Int
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseId        Int
  source          EnrolmentSource
  status          EnrolmentStatus  @default(ACTIVE)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?
  lastLesson      Lesson?          @relation("EnrolmentLastLesson", fields: [lastLessonId], references: [id], onDelete: SetNull)
  lastLessonId    Int?
  orderItems      OrderItem[]
  assignedBy      User?            @relation("EnrolmentAssigner", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedById    Int?
  // Cached completed lessons over published lessons, 0-100.
  progressPercent Int              @default(0)
  progress        LessonProgress[]
  quizAttempts    QuizAttempt[]
  scormStates     ScormState[]
  certificate     Certificate?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([lastLessonId])
  @@index([assignedById])
  @@map("enrolment")
}

model LessonProgress {
  id                  Int       @id @default(autoincrement())
  enrolment           Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  enrolmentId         Int
  lesson              Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId            Int
  completedAt         DateTime?
  lastPositionSeconds Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([enrolmentId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// What a SCORM package has told us about one learner: where they are, whether
// they finished, their score, and the package's own saved data (it reads this
// back to resume). One row per enrolment and lesson.
model ScormState {
  id               Int       @id @default(autoincrement())
  enrolment        Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  enrolmentId      Int
  lesson           Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId         Int
  // cmi.core.lesson_status: "not attempted", "incomplete", "completed", "passed", "failed", "browsed".
  lessonStatus     String    @default("not attempted") @db.VarChar(20)
  lessonLocation   String?   @db.VarChar(1000)
  scoreRaw         Float?
  scoreMin         Float?
  scoreMax         Float?
  // Opaque to us. The standard says 4096 characters; real packages use far more.
  suspendData      String?   @db.MediumText
  totalTimeSeconds Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([enrolmentId, lessonId])
  @@index([lessonId])
  @@map("scorm_state")
}

model CourseReview {
  id            Int          @id @default(autoincrement())
  user          User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Cascade)
  userId        Int
  course        Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId      Int
  // 1-5, checked in code.
  rating        Int
  title         String?      @db.VarChar(150)
  body          String?      @db.Text
  status        ReviewStatus @default(PENDING)
  moderatedBy   User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  moderatedById Int?
  moderatedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@unique([userId, courseId])
  @@index([courseId, status])
  @@index([moderatedById])
  @@map("course_review")
}

// One per quiz lesson.
model Quiz {
  id               Int           @id @default(autoincrement())
  lesson           Lesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId         Int           @unique
  // Percent needed to pass, 0-100.
  passingScore     Int           @default(70)
  attemptLimit     Int?
  timeLimitMinutes Int?
  passFeedback     String?       @db.Text
  failFeedback     String?       @db.Text
  shuffleQuestions Boolean       @default(false)
  questions        Question[]
  attempts         QuizAttempt[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@map("quiz")
}

model Question {
  id          Int          @id @default(autoincrement())
  quiz        Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      Int
  type        QuestionType
  text        String       @db.Text
  explanation String?      @db.Text
  points      Int          @default(1)
  position    Int
  // [{ id, text, correct }]; true/false questions hold two options.
  options     Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([quizId, position])
  @@map("question")
}

model QuizAttempt {
  id          Int       @id @default(autoincrement())
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      Int
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Cascade)
  enrolmentId Int
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      Int
  startedAt   DateTime  @default(now())
  submittedAt DateTime?
  score       Int?
  maxScore    Int?
  percent     Float?
  passed      Boolean?
  // { [questionId]: selected option ids }
  answers     Json?

  @@index([quizId, enrolmentId])
  @@index([enrolmentId])
  @@index([userId])
  @@map("quiz_attempt")
}

// Issued once per enrolment. The learner and course names are copied so the
// public verification page stays correct after a rename.
model Certificate {
  id          Int       @id @default(autoincrement())
  enrolment   Enrolment @relation(fields: [enrolmentId], references: [id], onDelete: Restrict)
  enrolmentId Int       @unique
  user        User      @relation("CertificateOwner", fields: [userId], references: [id], onDelete: Restrict)
  userId      Int
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseId    Int
  // LMS-XXXX-XXXX-XXXX, see generateCertificateCode in src/lib/course.ts.
  code        String    @unique @db.VarChar(32)
  issuedAt    DateTime  @default(now())
  revokedAt   DateTime?
  revokedBy   User?     @relation("CertificateRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedById Int?
  learnerName String
  courseTitle String
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([courseId])
  @@index([revokedById])
  @@map("certificate")
}

// ---------------------------------------------------------------------------
// Phase 5: Commerce
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum CustomerType {
  INDIVIDUAL
  BUSINESS
}

enum PaymentProvider {
  STRIPE
  // A total of 0 after a coupon: nothing is charged.
  FREE
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum OrderEventType {
  CREATED
  PAYMENT_STARTED
  PAID
  ENROLLED
  FAILED
  CANCELLED
  EXPIRED
  COUPON_RELEASED
  REFUND_REQUESTED
  REFUNDED
  NOTE
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

// Orders and everything under them are kept for the books: no cascade from a
// user or a course. Money is in pounds (Decimal 10,2); the rules in
// src/lib/commerce.ts work in whole pence.
model Order {
  id                      Int               @id @default(autoincrement())
  // ORD-YYYYMMDD-XXXXXX, see generateOrderNumber in src/lib/commerce.ts.
  orderNumber             String            @unique @db.VarChar(32)
  user                    User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId                  Int
  status                  OrderStatus       @default(PENDING)
  currency                String            @default("GBP") @db.VarChar(3)
  // Sum of the line prices, the coupon discount, and what is paid (subtotal - discountTotal).
  subtotal                Decimal           @db.Decimal(10, 2)
  discountTotal           Decimal           @default(0) @db.Decimal(10, 2)
  total                   Decimal           @db.Decimal(10, 2)
  refundedTotal           Decimal           @default(0) @db.Decimal(10, 2)
  coupon                  Coupon?           @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponId                Int?
  // Copied so the order still shows the code if the coupon is deleted.
  couponCode              String?           @db.VarChar(64)
  // Billing details, as asked for by the checkout's first step.
  customerType            CustomerType      @default(INDIVIDUAL)
  billingFirstName        String
  billingLastName         String
  billingCompany          String?
  billingAddressLine1     String
  billingAddressLine2     String?
  billingCity             String?
  billingPostcode         String            @db.VarChar(20)
  // ISO 3166-1 alpha-2.
  billingCountry          String            @default("GB") @db.VarChar(2)
  billingPhone            String?           @db.VarChar(40)
  // The buyer's address when the order was placed.
  email                   String
  stripeCheckoutSessionId String?           @unique @db.VarChar(255)
  stripePaymentIntentId   String?           @unique @db.VarChar(255)
  paidAt                  DateTime?
  cancelledAt             DateTime?
  // A pending order past this time is treated as expired (cancelled by the sweep).
  expiresAt               DateTime?
  // Where the buyer came from (campaign, referrer), copied from their browser
  // when the order was placed: see src/lib/tracking.ts.
  attribution             Json?
  // What the server-side purchase event needs (browser ids, IP, user agent).
  // Only filled when the buyer agreed to tracking; see src/services/tracking.ts.
  trackingContext         Json?
  // Set once the purchase was reported to the ad platforms, so it is sent once.
  purchaseTrackedAt       DateTime?
  items                   OrderItem[]
  payments                Payment[]
  refunds                 Refund[]
  events                  OrderEvent[]
  redemption              CouponRedemption?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([status, expiresAt])
  @@index([couponId])
  @@index([createdAt])
  @@map("order")
}

// One line per course, copied at purchase time. The course is restricted from
// deletion (deleteCourse reports it as "learner records").
model OrderItem {
  id          Int          @id @default(autoincrement())
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId     Int
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Restrict)
  courseId    Int
  courseTitle String
  // Price when ordered, the coupon's share of it, and unitPrice - discount.
  unitPrice   Decimal      @db.Decimal(10, 2)
  discount    Decimal      @default(0) @db.Decimal(10, 2)
  total       Decimal      @db.Decimal(10, 2)
  refundedAt  DateTime?
  // The enrolment fulfilOrder created or reactivated.
  enrolment   Enrolment?   @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  enrolmentId Int?
  refundItems RefundItem[]
  createdAt   DateTime     @default(now())

  @@unique([orderId, courseId])
  @@index([courseId])
  @@index([enrolmentId])
  @@map("order_item")
}

// A payment attempt. A retried pending order gets a new row (new Stripe session).
model Payment {
  id                      Int             @id @default(autoincrement())
  order                   Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId                 Int
  provider                PaymentProvider
  status                  PaymentStatus   @default(PENDING)
  amount                  Decimal         @db.Decimal(10, 2)
  currency                String          @default("GBP") @db.VarChar(3)
  stripeCheckoutSessionId String?         @unique @db.VarChar(255)
  stripePaymentIntentId   String?         @unique @db.VarChar(255)
  stripeChargeId          String?         @db.VarChar(255)
  cardBrand               String?         @db.VarChar(40)
  cardLast4               String?         @db.VarChar(4)
  receiptUrl              String?         @db.Text
  failureMessage          String?         @db.Text
  paidAt                  DateTime?
  refunds                 Refund[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([orderId])
  @@map("payment")
}

model Refund {
  id             Int          @id @default(autoincrement())
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId        Int
  payment        Payment      @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId      Int
  amount         Decimal      @db.Decimal(10, 2)
  reason         String?      @db.Text
  stripeRefundId String?      @unique @db.VarChar(255)
  status         RefundStatus @default(PENDING)
  failureMessage String?      @db.Text
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById    Int?
  items          RefundItem[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([orderId])
  @@index([paymentId])
  @@index([createdById])
  @@map("refund")
}

// The order lines a refund covered, with the amount returned for each.
model RefundItem {
  refund      Refund    @relation(fields: [refundId], references: [id], onDelete: Cascade)
  refundId    Int
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  orderItemId Int
  amount      Decimal   @db.Decimal(10, 2)

  @@id([refundId, orderItemId])
  @@index([orderItemId])
  @@map("refund_item")
}

// The order's timeline, oldest first.
model OrderEvent {
  id        Int            @id @default(autoincrement())
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId   Int
  type      OrderEventType
  message   String         @db.Text
  actor     User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId   Int?
  data      Json?
  createdAt DateTime       @default(now())

  @@index([orderId, createdAt])
  @@index([actorId])
  @@map("order_event")
}

// Stripe event ids already handled: inserting the id first (unique) makes the
// webhook idempotent.
model ProcessedStripeEvent {
  id          String   @id @db.VarChar(255)
  type        String   @db.VarChar(100)
  processedAt DateTime @default(now())

  @@index([processedAt])
  @@map("processed_stripe_event")
}

// Codes are stored upper-case. `value` is a percentage (0-100) or an amount in
// pounds, by discountType. Empty course and category lists mean no restriction.
model Coupon {
  id           Int                @id @default(autoincrement())
  code         String             @unique @db.VarChar(64)
  description  String?
  internalNote String?            @db.Text
  discountType CouponDiscountType
  value        Decimal            @db.Decimal(10, 2)
  active       Boolean            @default(true)
  startsAt     DateTime?
  expiresAt    DateTime?
  // Total uses across everyone / per learner; null is unlimited.
  usageLimit   Int?
  perUserLimit Int?
  minSpend     Decimal?           @db.Decimal(10, 2)
  courses      CouponCourse[]
  categories   CouponCategory[]
  // Learners the coupon is reserved for; none means anyone may use it.
  users        CouponUser[]
  redemptions  CouponRedemption[]
  orders       Order[]
  createdBy    User?              @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdById  Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([createdById])
  @@map("coupon")
}

model CouponCourse {
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId Int

  @@id([couponId, courseId])
  @@index([courseId])
  @@map("coupon_course")
}

model CouponCategory {
  coupon     Coupon         @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId   Int
  category   CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  @@id([couponId, categoryId])
  @@index([categoryId])
  @@map("coupon_category")
}

// A use of a coupon, taken when the order is placed. releasedAt is set when the
// order fails, is cancelled or expires: only rows with releasedAt null count.
// A personal coupon: only the listed learners may use it.
model CouponUser {
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponId Int
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   Int

  @@id([couponId, userId])
  @@index([userId])
  @@map("coupon_user")
}

model CouponRedemption {
  id         Int       @id @default(autoincrement())
  coupon     Coupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponId   Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  userId     Int
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderId    Int       @unique
  releasedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([couponId, releasedAt])
  @@index([userId, couponId, releasedAt])
  @@map("coupon_redemption")
}
